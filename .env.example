# VECDIM Environment Configuration & Secrets Template
# Copy this file to .env and adjust values for your environment.

# Server Settings
PORT=8080
APP_ENV=development

# Database Settings (PostgreSQL 16 + PostGIS 3.4)
DB_HOST=localhost
DB_PORT=5432
DB_USER=vecdim_admin
DB_PASSWORD=your_secure_password_here
DB_NAME=vecdim
DB_SSLMODE=disable

# Pipeline Cron Schedule Settings (Minutes)
CRON_INTERVAL_MINS=30
